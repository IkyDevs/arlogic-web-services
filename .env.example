# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Photo Proxy (Cloudflare Worker) ──────────────────────────────
# Domain for the Cloudflare Workers photo proxy.
# Worker: workers/photo-proxy/
# Setup: cd workers/photo-proxy && npm install && wrangler deploy
PHOTO_PROXY_DOMAIN=https://photos.arlogic.com
NEXT_PUBLIC_PHOTO_PROXY_URL=https://arlogic-photo-proxy.arlogic-photos.workers.dev

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token

# Telegram Channels — FALLBACK (dipakai jika channel per-cabang tidak di-set)
TELEGRAM_CHANNEL_ATTENDANCE=@channel
TELEGRAM_CHANNEL_SERVICE=@channel
TELEGRAM_CHANNEL_LAYANAN=@channel
TELEGRAM_CHANNEL_INVENTORY=@channel
TELEGRAM_CHANNEL_CLOSING=@channel
TELEGRAM_CHANNEL_CUSTOMER=@channel
TELEGRAM_CHANNEL_KASPIN=@channel
TELEGRAM_CHANNEL_TEKNISI_UPDATE=@channel
TELEGRAM_CHANNEL_QC_UPDATE=@channel
TELEGRAM_CHANNEL_BUKU_KAS=@channel
TELEGRAM_CHANNEL_STOCK_TRANSFER=@channel

# ─── Telegram Channels PER CABANG (prioritas utama) ─────────────────────
# Format: TELEGRAM_CHANNEL_{TIPE}_{KODE_CABANG}
# Contoh: TELEGRAM_CHANNEL_LAYANAN_JBR = channel transaksi cabang Jember
# Kode cabang = kolom `code` di tabel branches (JBR, KDS, dll)
# Isi dengan username channel asli. Biarkan kosong untuk fallback ke channel global.

# ═══════ JEMBER (JBR) ═══════
TELEGRAM_CHANNEL_ATTENDANCE_JBR=@channel
TELEGRAM_CHANNEL_SERVICE_JBR=@channel
TELEGRAM_CHANNEL_LAYANAN_JBR=@channel
TELEGRAM_CHANNEL_INVENTORY_JBR=@channel
TELEGRAM_CHANNEL_CLOSING_JBR=@channel
TELEGRAM_CHANNEL_CUSTOMER_JBR=@channel
TELEGRAM_CHANNEL_KASPIN_JBR=@channel
TELEGRAM_CHANNEL_TEKNISI_UPDATE_JBR=@channel
TELEGRAM_CHANNEL_QC_UPDATE_JBR=@channel
TELEGRAM_CHANNEL_BUKU_KAS_JBR=@channel
TELEGRAM_CHANNEL_STOCK_TRANSFER_JBR=@channel

# ═══════ KUDUS (KDS) ═══════
TELEGRAM_CHANNEL_ATTENDANCE_KDS=@channel
TELEGRAM_CHANNEL_SERVICE_KDS=@channel
TELEGRAM_CHANNEL_LAYANAN_KDS=@channel
TELEGRAM_CHANNEL_INVENTORY_KDS=@channel
TELEGRAM_CHANNEL_CLOSING_KDS=@channel
TELEGRAM_CHANNEL_CUSTOMER_KDS=@channel
TELEGRAM_CHANNEL_KASPIN_KDS=@channel
TELEGRAM_CHANNEL_TEKNISI_UPDATE_KDS=@channel
TELEGRAM_CHANNEL_QC_UPDATE_KDS=@channel
TELEGRAM_CHANNEL_BUKU_KAS_KDS=@channel
TELEGRAM_CHANNEL_STOCK_TRANSFER_KDS=@channel

# (Tambah blok per cabang baru: TELEGRAM_CHANNEL_{TIPE}_{KODE})

# Cron (Vercel Cron Jobs)
CRON_SECRET=your-cron-secret-token
